<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <!-- Export the .ipa to disk; upload separately with `xcrun altool --upload-app`. -->
    <key>destination</key>
    <string>export</string>
    <key>teamID</key>
    <string>7JF6XQC536</string>
    <key>signingStyle</key>
    <string>automatic</string>
    <!-- Without this, xcodebuild silently auto-increments CFBundleVersion at export
         time when App Store Connect already has that build number, so the .ipa no
         longer matches CURRENT_PROJECT_VERSION in project.yml. Keep exports
         deterministic and bump the build number in project.yml instead. -->
    <key>manageAppVersionAndBuildNumber</key>
    <false/>
    <key>uploadSymbols</key>
    <true/>
</dict>
</plist>
